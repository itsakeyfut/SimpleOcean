# 改行コード
* text=auto
*.cpp  text eol=crlf
*.h    text eol=crlf
*.cs   text eol=crlf
*.usf  text eol=crlf
*.ush  text eol=crlf
*.ini  text eol=crlf
*.uproject text eol=crlf
*.uplugin  text eol=crlf

# UEのバイナリアセット
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text

# テクスチャ・メディア
